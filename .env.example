VISION_API_PORT=8080
VISION_API_BASE_URL=http://127.0.0.1:8080
VITE_VISION_API_BASE_URL=http://127.0.0.1:8080
VISION_AI_SERVICE_URL=http://127.0.0.1:8001
VISION_SERVICE_PORT=8001
VISION_SERVICE_BASE_URL=http://127.0.0.1:8001
VISION_ADMIN_EMAIL=admin@vision.local
VISION_ADMIN_PASSWORD=vision123
VISION_ADMIN_TOKEN=vision-demo-token
VISION_WORKER_TOKEN=vision-worker-secret
VISION_UPLOAD_ROOT=assets/uploads
VISION_OUTPUT_ROOT=assets/outputs
VISION_DATA_ROOT=backend/data
VISION_REDIS_URL=redis://localhost:6379
VISION_S3_ENDPOINT=http://localhost:9000
VISION_S3_BUCKET=vision-media
VISION_SERVICE_FFMPEG_BIN=tools/ffmpeg/bin/ffmpeg.exe
VISION_SERVICE_REAL_ESRGAN_CMD=realesrgan-ncnn-vulkan -i "{input}" -o "{output}" -s {scale}
VISION_SERVICE_GFPGAN_CMD=python inference_gfpgan.py -i "{input}" -o "{output_dir}"
VISION_SERVICE_LAMA_CMD=python run_inpainting.py --image "{input}" --mask "{mask}" --output "{output}"
VISION_SERVICE_INSIGHTFACE_CMD=python run_faceswap.py --target "{input}" --source "{source}" --output "{output}"
VISION_SERVICE_U2NET_CMD=rembg i "{input}" "{output}"
VISION_SERVICE_RIFE_CMD=python inference_video.py --video "{input}" --output "{output}"
VISION_SERVICE_DEOLDIFY_CMD=python run_colorization.py --input "{input}" --output "{output}"
VISION_SERVICE_SCUNET_CMD=python run_denoise.py --input "{input}" --output "{output}"
VISION_SERVICE_SAM_CMD=python run_segmentation.py --input "{input}" --output "{output}"
VISION_SERVICE_JOB_TIMEOUT_SECONDS=600
VISION_SERVICE_MAX_INPUT_SIZE_MB=512
